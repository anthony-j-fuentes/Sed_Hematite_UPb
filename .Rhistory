na.omit()
return(read.data(samp, method = "U-Pb", format = 2, ierr = 2))
}
}
## This function produces summary data prior to filtering
get_spread_report <- function(df, name_filter) {
df <- df %>%
mutate(sample_grp = str_remove(X, "_\\d+$")) %>%
filter(str_detect(X, name_filter))
report_list <- list()
for (sg in unique(df$sample_grp)) {
df_sub <- df %>% filter(sample_grp == sg)
# Skip groups with 2 points or fewer
if (nrow(df_sub) <= 2) next
# Spread Calculations
p_low_u  <- df_sub[which.min(df_sub$Final.U238.Pb206_mean), ]
p_high_u <- df_sub[which.max(df_sub$Final.U238.Pb206_mean), ]
mean_x   <- mean(df_sub$Final.U238.Pb206_mean, na.rm = TRUE)
mean_y   <- mean(df_sub$Final.Pb207.Pb206_mean, na.rm = TRUE)
abs_u_spread  <- abs(p_high_u$Final.U238.Pb206_mean - p_low_u$Final.U238.Pb206_mean)
abs_pb_spread <- abs(p_high_u$Final.Pb207.Pb206_mean - p_low_u$Final.Pb207.Pb206_mean)
age_val <- mswd_val <- ci_val <- pb_int <- NaN
tryCatch({
grain_data <- splt_data(df, sg, prop = FALSE)
indiv_age  <- age(grain_data, method = "U238-Pb206",
type = 3, common.Pb = 0, isochron = TRUE, oerr = 2)
if (!is.null(indiv_age$par)) {
age_val  <- as.numeric(indiv_age$par['t'])
ci_val   <- as.numeric(indiv_age$err[2, 't'])
pb_int   <- as.numeric(indiv_age$par['76i'])
mswd_val <- as.numeric(indiv_age$mswd)
}
}, error = function(e) {})
report_list[[sg]] <- data.frame(
Sample_Name = sg,
U_Pb_Abs_Spread = round(abs_u_spread, 4),
Pb_Pb_Abs_Spread = round(abs_pb_spread, 4),
U_Pb_Pct_Spread  = round((abs_u_spread/mean_x)*100, 2),
Pb_Pb_Pct_Spread = round((abs_pb_spread/mean_y)*100, 2),
# Updated logic: returns "Negative" if y decreases as x increases
Valid_Slope = ifelse(p_high_u$Final.Pb207.Pb206_mean < p_low_u$Final.Pb207.Pb206_mean,
"Negative", "Positive"),
n_points = nrow(df_sub),
age = age_val, mswd = mswd_val, ci = ci_val, pb_intercept = pb_int,
stringsAsFactors = FALSE
)
}
return(bind_rows(report_list))
}
elbow_plot <- function(report_df, name, type = "Pb", scale = "relative", pos_slope = FALSE) {
# 1. Prepare data: Calculate Relative Error
plot_data <- report_df %>%
filter(!is.na(age), !is.na(ci), age > 0) %>%
mutate(rel_error_pct = (ci / age))
# Apply the pos_slope toggle filter
# If FALSE, ONLY keep the physically valid "Negative" slope points
if (!pos_slope) {
plot_data <- plot_data %>% filter(Valid_Slope == "Negative")
}
# 2. Logic to handle Type (U vs Pb) AND Scale (Absolute vs Relative)
if (type == "U") {
prefix <- "U/Pb"
if (scale == "relative") {
x_col <- "U_Pb_Pct_Spread"
x_label <- "Normalized U/Pb Spread (%)"
} else {
x_col <- "U_Pb_Abs_Spread"
x_label <- expression("Absolute" ~ {}^238 * U / {}^206 * Pb ~ "Spread")
}
} else if (type == "Pb") {
prefix <- "Pb/Pb"
if (scale == "relative") {
x_col <- "Pb_Pb_Pct_Spread"
x_label <- expression("Relative" ~ {}^207 * Pb / {}^206 * Pb ~ "Spread")
} else {
x_col <- "Pb_Pb_Abs_Spread"
x_label <- expression("Absolute" ~ {}^207 * Pb / {}^206 * Pb ~ "Spread")
}
} else {
stop("Type must be 'U' or 'Pb'")
}
# 3. Create the Plot
p <- ggplot(plot_data, aes(x = .data[[x_col]], y = rel_error_pct)) +
geom_point(aes(size = n_points, color = Valid_Slope), alpha = 0.7) +
scale_color_manual(values = c("Negative" = "#2c7bb6", "Positive" = "#d7191c")) +
theme_bw() +
labs(
title = paste("Single Grain Isochron Precision vs.", prefix, scale, "Spread"),
x = x_label,
y = "Relative Age Error (95% CI / Age)",
size = "n points",
color = "Slope"
) + theme(plot.title = element_text(face = "bold"))
# Conditionally remove the color legend if pos_slope is FALSE
if (!pos_slope) {
p <- p + guides(color = "none")
}
return(p)
}
audit_thrs <- function(report_df, start, end, step,
type = "Pb", scale = "relative",
precision_limit = 0.5) {
# 1. Determine which spread column to evaluate
if (type == "U") {
x_col <- if(scale == "relative") "U_Pb_Pct_Spread" else "U_Pb_Abs_Spread"
} else {
x_col <- if(scale == "relative") "Pb_Pb_Pct_Spread" else "Pb_Pb_Abs_Spread"
}
# 2. Define the threshold steps
threshold_steps <- seq(from = start, to = end, by = step)
# 3. Iterate through each threshold and calculate stats for the SURVIVING population
results <- lapply(threshold_steps, function(t) {
# Filter for grains that pass the threshold 't'
passed_data <- report_df %>%
filter(.data[[x_col]] >= t) %>%
filter(!is.na(age), !is.na(ci))
total_grains <- nrow(passed_data)
# Handle cases where no grains survive the filter
if (total_grains == 0) {
return(data.frame(
threshold = t,
total_grains = 0,
precise_grains = 0,
success_proportion = NaN,
stringsAsFactors = FALSE
))
}
# Count grains where relative error is WITHIN the precision limit (Successes)
# Note: Success means CI/Age <= precision_limit
precise_count <- sum((passed_data$ci / passed_data$age) <= precision_limit, na.rm = TRUE)
data.frame(
threshold = t,
total_grains = total_grains,
precise_grains = precise_count,
success_proportion = precise_count / total_grains,
stringsAsFactors = FALSE
)
})
return(bind_rows(results))
}
plot_audit_results <- function(audit_df, type = "Pb", scale = "relative",
hex_color = "#008080") {
# 1. Axis Label Logic using bquote for superscripts
if (type == "Pb") {
iso_math <- bquote(""^207*Pb/""^206*Pb)
} else {
iso_math <- bquote(""^238*U/""^206*Pb)
}
scale_txt <- if(scale == "relative") "Relative (%)" else "Absolute"
x_lab_final <- bquote("Threshold (" * .(scale_txt) ~ .(iso_math) * ")")
# 2. Create Plot
p <- ggplot(audit_df, aes(x = threshold, y = success_proportion)) +
# Updated 'linewidth' to satisfy the new ggplot2 requirements
geom_line(aes(group = 1), color = hex_color, linewidth = 1) +
# Shape 23 is the diamond with a separate border (color) and fill
geom_point(shape = 23,
size = 4,
fill = hex_color,
color = "black",
stroke = 0.8) +
scale_y_continuous(
limits = c(0, 1.05),
breaks = seq(0, 1, 0.1),
expand = c(0, 0.02)
) +
theme_bw() +
labs(
title = "Filtered Grains vs Threshold ",
x = x_lab_final,
y = "Propotion of Grains with CI/Age < 0.5"
) +
theme(
axis.title = element_text(size = 14),
plot.title = element_text(face = "bold")
)
return(p)
}
filter_composition<- function(upb,comp,print=FALSE){
filt_df<-upb%>% filter(sample_grp %in% comp$Grain)
if(print==TRUE){
print(unique(filt_df$sample_grp))}
return(filt_df)
}
filter_by_spread <- function(df, thrs, name_filter, type = "U", scale = "relative") {
df <- df %>%
mutate(sample_grp = str_remove(X, "_\\d+$")) %>%
filter(str_detect(X, name_filter))
filt_list <- list()
for (sg in unique(df$sample_grp)) {
df_sub <- df %>% filter(sample_grp == sg)
# Requirement: Must have more than 2 analyses
if (nrow(df_sub) <= 2) next
# Define endpoints based on U/Pb (standard for slope check)
p_low_u  <- df_sub[which.min(df_sub$Final.U238.Pb206_mean), ]
p_high_u <- df_sub[which.max(df_sub$Final.U238.Pb206_mean), ]
# 1. Determine which column to use based on 'type'
if (type == "U") {
vals <- df_sub$Final.U238.Pb206_mean
} else if (type == "Pb") {
vals <- df_sub$Final.Pb207.Pb206_mean
} else {
stop("Type must be 'U' or 'Pb'")
}
# 2. Calculate the spread based on 'scale'
abs_diff <- max(vals) - min(vals)
if (scale == "relative") {
actual_spread <- (abs_diff / mean(vals)) * 100
} else if (scale == "absolute") {
actual_spread <- abs_diff
} else {
stop("Scale must be 'relative' or 'absolute'")
}
# 3. Logic:
# Slope check: Pb/Pb must decrease as U/Pb increases
# Threshold check: Does it meet the 'thrs' value?
if (p_high_u$Final.Pb207.Pb206_mean < p_low_u$Final.Pb207.Pb206_mean) {
if (actual_spread >= thrs) {
filt_list[[sg]] <- df_sub
}
}
}
return(bind_rows(filt_list))
}
remove_pts <- function(df, pts,print=FALSE) {
filtered_df <- df
for (i in 1:nrow(pts)) {
sample <- pts$grain[i]
omit_spts <- as.character(pts$spots[i])  # Fix: grab only the current row's spot list
rmv_spt <- as.numeric(unlist(strsplit(omit_spts, ",")))
spts_to_remove <- paste0(sample, "_", rmv_spt)
if(print == TRUE){
print(spts_to_remove)}
# Remove matching sample spots
filtered_df <- filtered_df[!filtered_df$X %in% spts_to_remove, ]
}
return(filtered_df)
}
# This function filters grains based upon MSWD and appends the lower intercept ages and uncertainties
mswd_filt <- function(df, prop, thrs, age_prp) {
sample_groups <- unique(df$sample_grp)
filt_mswd <- data.frame()
for (sg in sample_groups) {
indiv_age <- tryCatch({
grain_data <- splt_data(df, sg, prop)
# type=3, oerr=2 ensures the CI is pre-calculated in the $err matrix
age(grain_data, method = "U238-Pb206", type = 3,
common.Pb = 0, isochron = TRUE, oerr = 2)
}, error = function(e) { return(NULL) })
if (is.null(indiv_age) || is.null(indiv_age$par)) next
# Extract directly from the object
age_val  <- as.numeric(indiv_age$par['t'])
# In oerr=2, the second row of the error matrix is the 95% CI
ci_val   <- as.numeric(indiv_age$err[2, 't'])
mswd_val <- as.numeric(indiv_age$mswd[1])
# Logical Filters
if (is.na(mswd_val) || mswd_val > thrs) next
if (is.na(age_val) || age_val > 4000) next
if (is.na(ci_val) || ci_val > (age_prp * age_val)) next
filt_mswd <- rbind(filt_mswd, data.frame(
sample = sg, age = age_val, mswd = mswd_val,
ci = ci_val, stringsAsFactors = FALSE
))
}
return(filt_mswd)
}
# Thus function generates summary tables
all_summary_data<-function(df,names,comp,prop,low=0,hi=0.5,step=0.005,
scale,type){
base_df <- df %>%
mutate(sample_grp = str_remove(X, "_\\d+$")) %>%
filter_composition(comp = comp)
summary_list<-imap(names, function(name,idx){
get_spread_report(base_df,name)
})
all_summary<-bind_rows(summary_list)
audit_df<-audit_thrs(all_summary,start=low,end=hi,step=step,
scale=scale,type=type)
return(list(sum=all_summary,audit=audit_df))
}
do_filtering <- function(df, name, prop, comp, pts,
low_thrs, up_thrs,
type, scale, mswd_cutoff, age_prop) {
# 1. Common Pre-processing
base_df <- df %>%
mutate(sample_grp = str_remove(X, "_\\d+$")) %>%
filter_composition(comp = comp)
# 2. Low Threshold Branch
df_low <- base_df %>%
# A. Check spread (includes bad points)
filter_by_spread(name_filter = name,
thrs = low_thrs,
type = type,
scale = scale) %>%
# B. Remove bad points (AFTER spread check)
remove_pts(pts = pts) %>%
# C. Calculate MSWD
mswd_filt(prop = prop, thrs = mswd_cutoff, age_prp = age_prop)
# 3. High Threshold Branch
df_high <- base_df %>%
# A. Check spread (includes bad points)
filter_by_spread(name_filter = name,
thrs = up_thrs,
type = type,
scale = scale) %>%
# B. Remove bad points (AFTER spread check)
remove_pts(pts = pts) %>%
# C. Calculate MSWD
mswd_filt(prop = prop, thrs = mswd_cutoff, age_prp = age_prop)
return(list(low_spread = df_low, high_spread = df_high))
}
text_ages<- function(df,txt_df,txt){
filt_tx<-txt_df%>% filter(texture==txt)
grains<-filt_tx$grain
filt_ages<- df%>% filter(sample %in% grains)
print(filt_ages$sample)
return(filt_ages)
}
